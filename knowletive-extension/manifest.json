{
  "manifest_version": 3,
  "name": "Knowletive Time Tracker",
  "version": "1.0.0",
  "description": "Employee time tracking for Knowletive.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://timetracker-api.knowletive.in/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
